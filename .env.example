# Google Cloud (server only). Base64 or raw JSON key of pitchroom-live@ashwanth-459106.iam.gserviceaccount.com
# (roles/aiplatform.user on every LIVE_PROJECTS project). Leave unset locally to use ADC:
#   gcloud auth application-default login
GOOGLE_SERVICE_ACCOUNT_JSON=
# Avatar seats are spread round-robin over these projects (avatar quota: 3 concurrent per project).
LIVE_PROJECTS=ashwanth-459106,gen-lang-client-0326702225
# Project for text models (fact-check, floor manager, report) and the scribe.
TEXT_PROJECT=ashwanth-459106

# Supabase. Without SUPABASE_SERVICE_ROLE_KEY the app stores sessions in .data/sessions (local dev only).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (or legacy anon) key — only needed for P2 auth + recording upload.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude writes the post-interview report (falls back to Gemini when unset).
ANTHROPIC_API_KEY=
REPORT_MODEL=claude-sonnet-5-5

# Who drains the shortlist queue: unset = the Next server after each report; "compute" = only the Supabase Compute
# worker (supabase/compute/shortlist-worker, `pnpm worker:build && supabase compute push shortlist-worker`).
SHORTLIST_CONSUMER=
